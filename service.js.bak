app.post("/cart/add", async (req, res) => {
  try {
    const { product_id, price_tag_id, quantity, user_id } = req.body;

    if (!product_id || !price_tag_id || !quantity) {
      return res.status(400).json({ message: "Missing required fields" });
    }

    // Execute SQL query properly
    await db.query(
      "INSERT INTO cart_items (user_id, product_id, price_tag_id, quantity, created_at, updated_at) VALUES (?, ?, ?, ?, NOW(), NOW())",
      [user_id, product_id, price_tag_id, quantity]
    );

    res.status(201).json({
      message: "Item added to cart",
      data: { user_id, product_id, price_tag_id, quantity },
    });
  } catch (error) {
    console.error("Error adding item to cart:", error);
    res.status(500).json({ message: "error" });
  }
});
app.delete("/cart/delete", async (req, res) => {
  try {
    const { user_id } = req.body; // Extract user_id

    if (!user_id) {
      return res.status(400).json({ message: "User ID is required" });
    }

    // Use db.promise().query() to return a Promise
    await db
      .promise()
      .query("DELETE FROM cart_items WHERE user_id = ?", [user_id]);

    res.status(201).json({ message: "Cart items deleted for the user" });
  } catch (error) {
    console.error("Error deleting cart items:", error);
    res.status(500).json({ message: "Server error" });
  }
});
// Sync Cart
app.post("/carts/sync", (req, res) => {
  const { data } = req.body;
  const token = req.headers.authorization?.split(" ")[1]; // Extract token from header

  if (!token) {
    return res.status(401).json({ error: "Unauthorized" });
  }

  // Verify token and get user ID
  jwt.verify(token, secretKey, (err, decoded) => {
    if (err) {
      return res.status(401).json({ error: "Invalid token" });
    }

    const userId = decoded.userId;

    // Clear existing cart items for the user
    db.query("DELETE FROM cart_items WHERE user_id = ?", [userId], (err) => {
      if (err) {
        console.error("Database error:", err);
        return res.status(500).json({ error: "Database error" });
      }

      // Insert new cart items
      const values = data.map((item) => [
        userId,
        item.product_id,
        item.price_tag_id,
        1, // Default quantity
        new Date().toISOString().slice(0, 19).replace("T", " "), // createdAt
        new Date().toISOString().slice(0, 19).replace("T", " "), // updatedAt
      ]);

      const query = `
        INSERT INTO cart_items (user_id, product_id, price_tag_id, quantity, createdAt, updatedAt)
        VALUES ?
      `;
      db.query(query, [values], (err, result) => {
        if (err) {
          console.error("Database error:", err);
          return res.status(500).json({ error: "Database error" });
        }

        // Fetch the updated cart items
        db.query(
          "SELECT * FROM cart_items WHERE user_id = ?",
          [userId],
          (err, results) => {
            if (err) {
              console.error("Database error:", err);
              return res.status(500).json({ error: "Database error" });
            }

            res.json({ data: results });
          }
        );
      });
    });
  });
});
